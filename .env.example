# Neon Postgres connection string, server-side only. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Server-only administrator identity. The account must sign in normally.
ADMIN_EMAIL=d.razorionov@gmail.com

# Transactional password recovery email (Resend; server-only).
RESEND_API_KEY=
RECOVERY_FROM_EMAIL=Root Helper <accounts@your-verified-domain.example>
